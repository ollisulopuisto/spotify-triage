{
  "name": "spotify-triage",
  "version": "1.0.0",
  "private": true,
  "description": "Search your monthly Spotify playlists as one library",
  "type": "module",
  "scripts": {
    "serve": "python3 -m http.server 8765 --bind 127.0.0.1",
    "test": "node --test tests/library.test.mjs",
    "test:ui": "node --test tests/ui.test.mjs",
    "test:sync": "node --test tests/sync.test.mjs",
    "test:all": "npm test && npm run test:ui && npm run test:sync"
  },
  "devDependencies": {
    "playwright": "^1.56.0"
  },
  "dependencies": {
    "@vercel/blob": "^2.7.0"
  }
}
